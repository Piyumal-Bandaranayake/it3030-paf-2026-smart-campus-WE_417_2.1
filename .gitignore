# ──────────────────────────────────────────
# Smart Campus Operations Hub — .gitignore
# ──────────────────────────────────────────

# ─── Environment / Secrets ───────────────
.env
.env.example
.env.local
.env.*.local
*.env

# ─── Backend (Java / Maven) ──────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.logs

# ─── Frontend (Node / Vite) ──────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── IDEs ────────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.user

# ─── OS ──────────────────────────────────
.DS_Store
Thumbs.db
